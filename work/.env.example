NODE_ENV=development
PORT=3000
DB_DRIVER=mock

# Nunca grave credenciais reais no codigo.
ORACLE_USER=usuario_da_aplicacao
ORACLE_PASSWORD=trocar-antes-de-publicar
ORACLE_CONNECT_STRING=host-ou-ip:1521/service_name
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

JWT_SECRET=troque-por-um-segredo-longo-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
# Use 1 quando houver um Nginx na frente da aplicacao.
TRUST_PROXY=false

# Limites separados para evitar bloqueio normal da aplicacao.
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1500
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=30

# Integracao RM. Nunca versionar usuario/senha reais.
RM_API_ENABLED=false
RM_API_BASE_URL=https://rm.exemplo.local/api
RM_API_USER=usuario_rm
RM_API_PASSWORD=trocar-antes-de-publicar
RM_API_TIMEOUT_MS=15000
RM_API_RETRIES=2
