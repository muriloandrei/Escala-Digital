{
  "name": "escala-digital",
  "version": "0.1.0",
  "private": true,
  "description": "Escala Digital: aplicacao web para geracao e armazenamento de escalas em Oracle.",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build:client": "vite build --config frontend/vite.config.mjs",
    "check:client": "tsc --project frontend/tsconfig.json --noEmit",
    "check": "node --check src/server.js",
    "migrations:check": "node scripts/check-migrations.js",
    "migrations:status": "node scripts/migration-ledger.js status",
    "migrations:record": "node scripts/migration-ledger.js record",
    "db:check-schema": "node scripts/check-schema.js",
    "rollout:check-ui": "node scripts/check-react-rollout.js",
    "test": "node test/run-tests.js",
    "smoke:api": "node scripts/smoke-api-flow.js",
    "smoke:perfis": "node scripts/smoke-perfis-flow.js",
    "smoke:react-allowlist": "node scripts/smoke-react-allowlist.js",
    "smoke:eventos": "node scripts/smoke-event-transaction.js",
    "smoke:rm-outbox": "node scripts/smoke-rm-outbox.js",
    "rm:processar-pendentes": "node scripts/processar-pendencias-rm.js",
    "turnos:padrao": "node scripts/recriar-turnos-padrao-secao.js",
    "seed:dashboard": "node scripts/seed-dashboard-test-data.js",
    "usuarios:corrigir-lojas": "node scripts/corrigir-usuarios-loja.js",
    "escalas:limpar-criadas": "node scripts/limpar-escalas-criadas.js",
    "escalas:corrigir-oficializacao": "node scripts/corrigir-oficializacao-escalas.js",
    "correcao:aprendiz-descansos": "node scripts/corrigir-aprendiz-descansos.js",
    "subsecoes:aprendiz": "node scripts/sincronizar-subsecao-aprendiz.js",
    "senhas:migrar-md5": "node scripts/migrar-senhas-md5.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.49.0",
    "oracledb": "^6.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
